# PHX Offline AI Appliance — Environment Variables
# Copy this file to .env and fill in all values before starting the stack.
# NEVER commit .env to version control.
# NEVER hardcode secrets in source code.

# =============================================================================
# POSTGRES
# =============================================================================
POSTGRES_HOST=phx-postgres
POSTGRES_PORT=5432
POSTGRES_DB=phx
POSTGRES_USER=phx
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# =============================================================================
# API
# =============================================================================
# Secret key for JWT signing — generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# API internal port
API_PORT=8000

# Tenant identifier for this deployment (e.g., acme-corp)
TENANT_ID=default

# =============================================================================
# QDRANT
# =============================================================================
QDRANT_HOST=phx-qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=phx_chunks

# =============================================================================
# OLLAMA
# =============================================================================
OLLAMA_HOST=phx-ollama
OLLAMA_PORT=11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# =============================================================================
# INGEST
# =============================================================================
# Path inside the ingest container where customer data is mounted
INGEST_DATA_ROOT=/customer_data

# Sources config file path (inside container)
SOURCES_CONFIG_PATH=/app/config/sources.yaml

# How often to run scheduled sync (cron expression or seconds interval)
INGEST_SCHEDULE_SECONDS=3600

# =============================================================================
# UI
# =============================================================================
UI_PORT=3000
# URL the browser uses to reach the API (can differ from internal docker name)
VITE_API_URL=http://localhost:8000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL: External DB connectors
# These are configured per-source in sources.yaml, but you can set defaults here.
# =============================================================================

# Example Postgres source (read-only credentials)
# EXT_PG_HOST=
# EXT_PG_PORT=5432
# EXT_PG_DB=
# EXT_PG_USER=
# EXT_PG_PASSWORD=

# Example SQL Server source (read-only credentials)
# EXT_MSSQL_HOST=
# EXT_MSSQL_PORT=1433
# EXT_MSSQL_DB=
# EXT_MSSQL_USER=
# EXT_MSSQL_PASSWORD=
